module Netting where

-- An intercompany payable: DEBTOR owes CREDITOR AMOUNTMINOR (integer minor
-- units, never a float) in CURRENCY, due DUEDATE.
-- The operator (treasury service) and the debtor co-sign creation; the creditor
-- observes. Nobody else on the ledger sees this contract.
template Obligation
  with
    operator : Party
    debtor : Party
    creditor : Party
    amountMinor : Int
    currency : Text
    dueDate : Date
    reference : Text
  where
    ensure amountMinor > 0 && currency /= "" && reference /= ""
    signatory operator, debtor
    observer creditor

    -- Consuming: archives the obligation. This choice is operator-controlled by
    -- design (liveness: a debtor must never be able to block archival of their
    -- own settled debt, and the operator is the party that runs settlement).
    -- It does NOT by itself prove a settlement happened: settlement integrity
    -- (approvals from every stakeholder, matching terms, receipts issued)
    -- is enforced in NettingProposal.Execute below, which is the only path
    -- that issues SettlementReceipts. Direct exercise archives without receipts
    -- and is visible on-ledger as such; operating procedure must treat an
    -- obligation archived with no corresponding receipts as an incident.
    choice Settle : ()
      controller operator
      do return ()

-- A subsidiary's approval of one specific proposal. Signed by the approver
-- alone, observed by the operator, so any party can approve without needing
-- the operator's authority at approval time.
-- TERMSHASH binds the approval to the exact proposal terms (currency, obligation
-- set, residual transfers, approver set, expiry). Execute refuses approvals whose
-- hash does not match, so an operator cannot swap the proposal contents after
-- approval was given.
template Approval
  with
    operator : Party
    approver : Party
    proposalId : Text
    termsHash : Text
  where
    ensure proposalId /= "" && termsHash /= ""
    signatory approver
    observer operator

-- A computed multilateral netting proposal over a set of obligations.
-- RESIDUALS are the (from, to, amountMinor) transfers replacing gross
-- settlement. EXECUTE archives every listed obligation and issues one receipt
-- per residual in a single atomic transaction: partial settlement is impossible
-- by construction, because a failed sub-action aborts the whole transaction.
-- A fully-netted cycle (every position cancels) carries an empty residual list
-- and settles by archiving obligations with no transfers — the ideal outcome,
-- not an error.
template NettingProposal
  with
    operator : Party
    proposalId : Text
    currency : Text
    obligationCids : [ContractId Obligation]
    residuals : [(Party, Party, Int)]
    requiredApprovers : [Party]
    expiresAt : Time
    -- Canonical hash of the terms above; approvers sign over this value.
    termsHash : Text
  where
    ensure proposalId /= "" && not (null obligationCids) && not (null requiredApprovers) && termsHash /= ""
    signatory operator
    observer requiredApprovers

    choice Execute : [ContractId SettlementReceipt]
      with
        approvalCids : [ContractId Approval]
      controller operator
      do
        now <- getTime
        assertMsg "proposal expired" (now <= expiresAt)
        approvals <- mapA (\cid -> fetch cid) approvalCids
        let approvers = map (.approver) (filter (\a -> a.proposalId == proposalId) approvals)
        assertMsg "missing approvals" (all (`elem` approvers) requiredApprovers)
        assertMsg
          "approval does not cover these proposal terms"
          (all (\a -> a.proposalId /= proposalId || a.termsHash == termsHash) approvals)
        assertMsg
          "approval from wrong operator"
          (all (\a -> a.proposalId /= proposalId || a.operator == operator) approvals)
        -- The approver set must cover every stakeholder of every settled debt.
        -- requiredApprovers is operator-supplied, so without this check the
        -- operator could settle a victim's obligation using approvals from a
        -- colluding party the victim never authorized.
        obligations <- mapA (\cid -> fetch cid) obligationCids
        let stakeholders = concatMap (\o -> [o.debtor, o.creditor]) obligations
        assertMsg "approvers must cover all obligation stakeholders" (all (`elem` approvers) stakeholders)
        mapA (\obligationCid -> exercise obligationCid Settle) obligationCids
        mapA
          (\(from, to, amount) ->
            create SettlementReceipt with
              operator
              proposalId
              from
              to
              amountMinor = amount
              currency
              settledAt = now
          )
          residuals

-- Per-subsidiary evidence of settlement. FROM and TO observe only their own
-- receipt; they learn nothing about other residuals in the batch *from the
-- receipt itself*. Note the proposal-level caveat: every required approver
-- observes the full NettingProposal including the complete residual matrix,
-- which informed consent requires. Receipt partitioning limits what a party
-- learns after the fact, not what approvers see while deciding.
template SettlementReceipt
  with
    operator : Party
    proposalId : Text
    from : Party
    to : Party
    amountMinor : Int
    currency : Text
    settledAt : Time
  where
    ensure amountMinor > 0
    signatory operator
    observer from, to
