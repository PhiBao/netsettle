module NettingTest where

import Daml.Script
import DA.Date (toDateUTC)
import DA.List (find)
import DA.Text (isInfixOf)
import DA.Time (addRelTime, days)
import Netting

-- Idempotent allocation: reuse any party already on the ledger with this hint.
-- Re-running the bootstrap against a live sandbox (or restarting the app in a
-- demo session) must not fail with "party already exists".
allocateOrReuse : Text -> Script Party
allocateOrReuse hint = do
  known <- listKnownParties
  case find (\p -> hint `isInfixOf` show p.party) known of
    Some details -> pure details.party
    None -> allocateParty hint

-- Canonical demo: DE -> FR 100k, FR -> SG 80k, SG -> DE 60k (USD minor units).
-- Net: DE owes 40k; FR is owed 20k; SG is owed 20k.
-- Expected residuals: DE -> FR 20k, DE -> SG 20k.
setupParties : Script (Party, Party, Party, Party)
setupParties = script do
  operator <- allocateOrReuse "TreasuryOps"
  de <- allocateOrReuse "AcmeDE"
  fr <- allocateOrReuse "AcmeFR"
  sg <- allocateOrReuse "AcmeSG"
  return (operator, de, fr, sg)

createDemoObligations : Party -> Party -> Party -> Party -> Script [ContractId Obligation]
createDemoObligations operator de fr sg = script do
  now <- getTime
  let due = toDateUTC now
  o1 <- submitMulti [operator, de] [] do
    createCmd Obligation with
      operator
      debtor = de
      creditor = fr
      amountMinor = 10000000
      currency = "USD"
      dueDate = due
      reference = "INV-001"
  o2 <- submitMulti [operator, fr] [] do
    createCmd Obligation with
      operator
      debtor = fr
      creditor = sg
      amountMinor = 8000000
      currency = "USD"
      dueDate = due
      reference = "INV-002"
  o3 <- submitMulti [operator, sg] [] do
    createCmd Obligation with
      operator
      debtor = sg
      creditor = de
      amountMinor = 6000000
      currency = "USD"
      dueDate = due
      reference = "INV-003"
  return [o1, o2, o3]

createDemoProposal : Party -> Party -> Party -> Party -> [ContractId Obligation] -> Script (ContractId NettingProposal)
createDemoProposal operator de fr sg obligations = script do
  expiry <- addRelTime <$> getTime <*> pure (days 30)
  submit operator do
    createCmd NettingProposal with
      operator
      proposalId = "PROP-0001"
      currency = "USD"
      obligationCids = obligations
      residuals = [(de, fr, 2000000), (de, sg, 2000000)]
      requiredApprovers = [de, fr, sg]
      expiresAt = expiry
      termsHash = "demo-terms-v1"

approveAll : Party -> Party -> Party -> Party -> Script [ContractId Approval]
approveAll operator de fr sg = script do
  a1 <- submit de do
    createCmd Approval with operator, approver = de, proposalId = "PROP-0001", termsHash = "demo-terms-v1"
  a2 <- submit fr do
    createCmd Approval with operator, approver = fr, proposalId = "PROP-0001", termsHash = "demo-terms-v1"
  a3 <- submit sg do
    createCmd Approval with operator, approver = sg, proposalId = "PROP-0001", termsHash = "demo-terms-v1"
  return [a1, a2, a3]

-- Allocate the fourth demo subsidiary for the web demo dataset.
setupDemoExtra : Script Party
setupDemoExtra = allocateOrReuse "AcmeUS"

-- Positive path: full approvals, atomic execution, two receipts, obligations gone.
testExecute : Script ()
testExecute = script do
  (operator, de, fr, sg) <- setupParties
  obligations <- createDemoObligations operator de fr sg
  proposal <- createDemoProposal operator de fr sg obligations
  approvals <- approveAll operator de fr sg
  receipts <- submit operator do exerciseCmd proposal Execute with approvalCids = approvals
  assert (length receipts == 2)
  -- Obligations must be archived: the operator sees nothing active.
  remaining <- query @Obligation operator
  assert (null remaining)

-- Negative path: execution without every approval must fail; nothing settles.
testExecuteBlocked : Script ()
testExecuteBlocked = script do
  (operator, de, fr, sg) <- setupParties
  obligations <- createDemoObligations operator de fr sg
  proposal <- createDemoProposal operator de fr sg obligations
  partial <- submit de do
    createCmd Approval with operator, approver = de, proposalId = "PROP-0001", termsHash = "demo-terms-v1"
  submitMustFail operator do exerciseCmd proposal Execute with approvalCids = [partial]
  -- And the obligations are still live: nothing partially settled.
  remaining <- query @Obligation operator
  assert (length remaining == 3)
  -- Approvals for other proposals do not count either.
  decoy <- submit fr do
    createCmd Approval with operator, approver = fr, proposalId = "PROP- decoy", termsHash = "demo-terms-v1"
  submitMustFail operator do exerciseCmd proposal Execute with approvalCids = [partial, decoy]

-- Approvals are bound to the exact terms: a full set of approvals carrying a
-- different terms hash must not settle, even though every approver signed.
testExecuteBlockedOnTermsMismatch : Script ()
testExecuteBlockedOnTermsMismatch = script do
  (operator, de, fr, sg) <- setupParties
  obligations <- createDemoObligations operator de fr sg
  proposal <- createDemoProposal operator de fr sg obligations
  bad <- mapA
    (\(party, name) -> submit party do
      createCmd Approval with
        operator, approver = party, proposalId = "PROP-0001", termsHash = name)
    [(de, "wrong-terms"), (fr, "wrong-terms"), (sg, "wrong-terms")]
  submitMustFail operator do exerciseCmd proposal Execute with approvalCids = bad
  remaining <- query @Obligation operator
  assert (length remaining == 3)

-- Fully-netted cycle: every position cancels, so there is nothing to transfer.
-- Execution must still archive all obligations atomically, with zero receipts.
testExecuteFullNetting : Script ()
testExecuteFullNetting = script do
  (operator, de, fr, sg) <- setupParties
  now <- getTime
  let due = toDateUTC now
  -- A perfect cycle: DE -> FR -> SG -> DE, equal amounts.
  o1 <- submitMulti [operator, de] [] do
    createCmd Obligation with operator, debtor = de, creditor = fr, amountMinor = 1000000, currency = "USD", dueDate = due, reference = "FULL-1"
  o2 <- submitMulti [operator, fr] [] do
    createCmd Obligation with operator, debtor = fr, creditor = sg, amountMinor = 1000000, currency = "USD", dueDate = due, reference = "FULL-2"
  o3 <- submitMulti [operator, sg] [] do
    createCmd Obligation with operator, debtor = sg, creditor = de, amountMinor = 1000000, currency = "USD", dueDate = due, reference = "FULL-3"
  expiry <- addRelTime <$> getTime <*> pure (days 30)
  proposal <- submit operator do
    createCmd NettingProposal with
      operator
      proposalId = "PROP-FULL"
      currency = "USD"
      obligationCids = [o1, o2, o3]
      residuals = []
      requiredApprovers = [de, fr, sg]
      expiresAt = expiry
      termsHash = "demo-terms-full"
  approvals <- mapA
    (\party -> submit party do
      createCmd Approval with
        operator, approver = party, proposalId = "PROP-FULL", termsHash = "demo-terms-full")
    [de, fr, sg]
  receipts <- submit operator do exerciseCmd proposal Execute with approvalCids = approvals
  assert (null receipts)
  remaining <- query @Obligation operator
  assert (null remaining)

-- The approver set must cover every stakeholder of every settled debt: a
-- proposal naming only a colluding party cannot settle a victim's obligation,
-- even with that party's genuine approval.
testExecuteBlockedOnWrongApproverSet : Script ()
testExecuteBlockedOnWrongApproverSet = script do
  (operator, de, fr, sg) <- setupParties
  obligations <- createDemoObligations operator de fr sg
  expiry <- addRelTime <$> getTime <*> pure (days 30)
  proposal <- submit operator do
    createCmd NettingProposal with
      operator
      proposalId = "PROP-SOCKPUPPET"
      currency = "USD"
      obligationCids = obligations
      residuals = [(de, fr, 2000000)]
      requiredApprovers = [operator]
      expiresAt = expiry
      termsHash = "demo-terms-sockpuppet"
  sockpuppet <- submit operator do
    createCmd Approval with operator, approver = operator, proposalId = "PROP-SOCKPUPPET", termsHash = "demo-terms-sockpuppet"
  submitMustFail operator do exerciseCmd proposal Execute with approvalCids = [sockpuppet]
  remaining <- query @Obligation operator
  assert (length remaining == 3)

-- An empty approver set must be rejected at creation: vacuous `all` over `[]`
-- would otherwise let Execute run with zero approvals.
testProposalRequiresApprovers : Script ()
testProposalRequiresApprovers = script do
  (operator, de, fr, sg) <- setupParties
  obligations <- createDemoObligations operator de fr sg
  expiry <- addRelTime <$> getTime <*> pure (days 30)
  submitMustFail operator do
    createCmd NettingProposal with
      operator
      proposalId = "PROP-EMPTY"
      currency = "USD"
      obligationCids = obligations
      residuals = [(de, fr, 2000000)]
      requiredApprovers = []
      expiresAt = expiry
      termsHash = "demo-terms-empty"
